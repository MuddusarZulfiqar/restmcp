{
  "name": "@api-mcp/express",
  "version": "0.1.0",
  "description": "Express adapter: converts an Express app's routes into MCP tools and mounts POST /mcp",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "express",
    "ai",
    "llm",
    "agent",
    "tools",
    "rest-api"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": ["dist", "!dist/**/*.map"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --build",
    "clean": "rimraf dist *.tsbuildinfo",
    "test": "vitest run --root ../.."
  },
  "dependencies": {
    "@api-mcp/core": "0.1.0"
  },
  "peerDependencies": {
    "express": "^4.18.0 || ^5.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "express": "^4.21.1",
    "rimraf": "^6.0.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
