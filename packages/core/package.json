{
  "name": "@api-mcp/core",
  "version": "0.1.0",
  "description": "Framework-agnostic pipeline: routes -> OpenAPI -> JSON Schema -> MCP tools -> MCP server",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai",
    "llm",
    "agent",
    "tools",
    "openapi",
    "json-schema",
    "rest-api"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --build",
    "clean": "rimraf dist *.tsbuildinfo",
    "test": "vitest run --root ../.."
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "minimatch": "^10.0.1"
  },
  "devDependencies": {
    "rimraf": "^6.0.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
