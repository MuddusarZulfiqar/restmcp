{
  "name": "@muddusarzulfiqar/restmcp",
  "version": "0.1.0",
  "description": "CLI for @restmcp: inspect, generate, and export MCP tool definitions from an existing Express/NestJS app",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "cli",
    "ai",
    "llm",
    "openapi",
    "rest-api"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "restmcp": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": ["dist", "!dist/**/*.map"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MuddusarZulfiqar/restmcp.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/MuddusarZulfiqar/restmcp#readme",
  "bugs": {
    "url": "https://github.com/MuddusarZulfiqar/restmcp/issues"
  },
  "author": "Muddusar Zulfiqar",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --build",
    "clean": "rimraf dist *.tsbuildinfo",
    "test": "vitest run --root ../.."
  },
  "dependencies": {
    "@restmcp/core": "0.1.0",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "rimraf": "^6.0.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
