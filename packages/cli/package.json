{
  "name": "api-mcp",
  "version": "0.1.0",
  "description": "CLI for @api-mcp: inspect, generate, and export MCP tool definitions from an existing Express/NestJS app",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "cli",
    "ai",
    "llm",
    "openapi",
    "rest-api"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "api-mcp": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": ["dist", "!dist/**/*.map"],
  "scripts": {
    "build": "tsc --build",
    "clean": "rimraf dist *.tsbuildinfo",
    "test": "vitest run --root ../.."
  },
  "dependencies": {
    "@api-mcp/core": "0.1.0",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "rimraf": "^6.0.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
